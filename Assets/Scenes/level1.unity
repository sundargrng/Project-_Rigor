--- !u!114 &385972673
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 385972668}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f337b7db6aeb86c4e9a77b0bf7306e20, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - actorID: 0
    message: (whispers) I never understood why we demons don't have names.
  - actorID: 0
    message: 'It''s as if we''re meant to fade into the shadows, without identity
      or purpose. '
  - actorID: 1
    message: . . .
  - actorID: 0
    message: But I. . . I REFUSE!!! to accept that.
  - actorID: 0
    message: I want to find a name for myself. . .
  - actorID: 0
    message: a name that will echo through the ages. . .
  - actorID: 0
    message: 'a name that will make demons and humans alike TREMBLE at the mention
      of it. '
  - actorID: 1
    message: . . .
  - actorID: 0
    message: I know you can't answer me, Father.
  - actorID: 0
    message: But I need to believe that you're watching me. . .Maybe I'll find my
      name in the distant lands beyond our realm. . .
  - actorID: 0
    message: Maybe there, among the humans and other creatures, I'll discover who
      I truly am.
  - actorID: 1
    message: . . .
  actors:
  - actorName: Nameless One
    sprite: {fileID: 0}
  - actorName: Gravestone
    sprite: {fileID: 0}
